APP_NAME=Material Science KG Platform
APP_ENV=development
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/materials
REDIS_URL=redis://redis:6379/0

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

CORS_ORIGINS=http://localhost:3000

UPLOAD_DIR=app/data/documents
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150

EMBEDDING_MODEL_NAME=BAAI/bge-large-en
EMBEDDING_DIMENSION=1024
EMBEDDING_FALLBACK_ONLY=false
CHAT_DEFAULT_TOP_K=5
CHAT_GRAPH_TOP_K=5
CHAT_GRAPH_CANDIDATE_POOL=60

GRAPH_ENABLED=true

AUTH_JWT_SECRET=change-this-in-production
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

EXTRACTION_ENABLE_SPACY=false
EXTRACTION_SPACY_MODEL=en_core_web_sm
EXTRACTION_ENABLE_SCIBERT=false
EXTRACTION_SCIBERT_MODEL=
EXTRACTION_SCIBERT_DEVICE=-1
